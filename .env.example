# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Key (required for embeddings and signal extraction)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Companies House API Key (free - 600 requests per 5 minutes)
# Get from: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# Adzuna API Credentials (free tier: 250 requests/month)
# Get from: https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Hunter.io API Key (free tier: 25 requests/month)
# Get from: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# NewsAPI.org API Key (free tier: 100 requests/day)
# Get from: https://newsapi.org/account
NEWS_API_KEY=your_news_api_key_here

# FCA Register doesn't require an API key (public data)
# Data is fetched directly from FCA public endpoints
